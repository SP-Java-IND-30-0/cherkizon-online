<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    <changeSet id="3-drop-expired-fields-add-expiresAt" author="Goodwin999">
        <dropColumn tableName="tokens" columnName="expired"/>
        <dropColumn tableName="tokens" columnName="revoked"/>
        <addColumn tableName="tokens">
            <column name="expires_at" type="timestamp" defaultValueComputed="NOW()"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>